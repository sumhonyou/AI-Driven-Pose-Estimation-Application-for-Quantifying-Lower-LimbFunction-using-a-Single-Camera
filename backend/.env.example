APP_ENV=development
DATABASE_URL=postgresql+psycopg://fyp_user:fyp_password@localhost:5432/fyp_rehab_db
JWT_SECRET_KEY=replace_with_at_least_32_char_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Stage 6.4: optional after-set coaching-text rewrite (rules.md #12/#13). The report
# works fully without any of these set -- FEEDBACK_LLM_ENABLED defaults to false.
# Current provider: Groq. LLM_MODEL must be a model id Groq actually hosts (see
# docs/groq_model_verification.md for the last-verified list and free-tier limits).
LLM_API_KEY=replace_with_your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
FEEDBACK_LLM_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5180
